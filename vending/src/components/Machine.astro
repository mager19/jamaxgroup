---
import { Image } from 'astro:assets';
import content from '../data/content.json';
import { mediaItem } from '../lib/media';

const m = content.machine;
const studio = mediaItem('escenas/maquina-estudio.webp');
const qr = mediaItem('escenas/pago-qr.webp');
---
<section id="maquina" class="section bg-mist" aria-labelledby="machine-title">
  <div class="wrap grid">
    <figure class="studio">
      <Image src={studio.src} alt={studio.alt} widths={[480, 760, 1024]} sizes="(max-width: 960px) 92vw, 560px" />
    </figure>
    <div class="info">
      <h2 id="machine-title" class="display h-lg">La <span class="hl">máquina</span></h2>
      <p class="lead">{m.name}. {m.intro}</p>
      <dl class="specs">
        {m.specs.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <div class="pay">
        <Image class="pay-img" src={qr.src} alt={qr.alt} widths={[240, 480]} sizes="160px" />
        <div>
          <h3 class="display h-md">Pagos</h3>
          <ul class="chips">{m.payments.map((p) => <li>{p}</li>)}</ul>
          <p class="muted small">{m.paymentsNote}</p>
        </div>
      </div>
      <div>
        <h3 class="display h-md">Qué vende</h3>
        <ul class="chips">{m.products.map((p) => <li>{p}</li>)}</ul>
        <p class="muted small">{m.productsNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .grid > * { min-width: 0; }
  .studio { background: #e9e9e9; border-radius: var(--r-card); overflow: hidden; position: sticky; top: 96px; }
  .studio :global(img) { width: 100%; }
  .info { display: grid; gap: 30px; }
  .specs { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }
  .specs div { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .specs div:nth-child(odd) { padding-right: 16px; }
  dt { font-size: 14px; color: var(--slate); }
  dd { font-weight: 700; font-size: 19px; font-variant-numeric: tabular-nums; }
  .pay { display: grid; grid-template-columns: 160px 1fr; gap: 22px; align-items: center; }
  .pay :global(.pay-img) { width: 160px; aspect-ratio: 1; object-fit: cover; border-radius: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 10px; }
  .chips li { padding: 8px 14px; border-radius: var(--pill); background: var(--paper); border: 1px solid var(--line); font-weight: 600; font-size: 15px; }
  .small { font-size: 15px; }
  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .studio { position: static; max-width: 560px; }
  }
  @media (max-width: 480px) {
    .pay { grid-template-columns: 1fr; }
    .specs { grid-template-columns: 1fr; }
  }
</style>
