---
import site from '../data/site.json';
import { formKey, formReady, waLink } from '../lib/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const ready = formReady();
if (!ready) {
  console.warn('[vending] Web3Forms key is still a placeholder: the request form is disabled until src/data/site.json has a real key.');
}
const wa = waLink();
const redirect = new URL('/gracias/', Astro.site).href;
const types = ['Conjunto residencial', 'Oficina o empresa', 'Otro'];
---
<section id="contacto" class="section on-lime" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="info">
      <h2 id="contact-title" class="display h-lg">Pida su máquina</h2>
      <p class="lead">Cuéntenos de su conjunto o empresa. Lo contactamos para visitar el espacio y revisar el acuerdo.</p>
      <p class="coverage">{site.coverage}</p>
      <div class="alt">
        <p>¿Prefiere escribirnos directo?</p>
        {wa && <a class="btn btn-primary" href={wa} target="_blank" rel="noopener"><WhatsAppIcon /> Escribir por WhatsApp</a>}
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <div class="form-col">
      <form class="form" method="POST" action="https://api.web3forms.com/submit" data-contact-form>
        <input type="hidden" name="access_key" value={formKey()} />
        <input type="hidden" name="redirect" value={redirect} />
        <input type="hidden" name="subject" value={`Nueva solicitud de máquina ${site.brand}`} />
        <input type="hidden" name="from_name" value={`${site.brand} — landing`} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="row two">
          <div class="field">
            <label for="f-nombre">Nombre</label>
            <input id="f-nombre" name="nombre" type="text" autocomplete="name" required data-msg="Escriba su nombre." />
          </div>
          <div class="field">
            <label for="f-cargo">Cargo <span class="opt">(opcional)</span></label>
            <input id="f-cargo" name="cargo" type="text" autocomplete="organization-title" placeholder="Administrador, miembro del consejo…" />
          </div>
        </div>
        <div class="row two">
          <div class="field">
            <label for="f-tipo">Tipo de lugar</label>
            <select id="f-tipo" name="tipo" required data-msg="Elija el tipo de lugar.">
              <option value="">Elija una opción</option>
              {types.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-organizacion">Nombre del conjunto o empresa <span class="opt">(opcional)</span></label>
            <input id="f-organizacion" name="organizacion" type="text" autocomplete="organization" />
          </div>
        </div>
        <div class="row two">
          <div class="field">
            <label for="f-ciudad">Municipio</label>
            <input id="f-ciudad" name="ciudad" type="text" autocomplete="address-level2" required data-msg="Escriba el municipio." placeholder="Medellín, Bello, Envigado…" />
          </div>
          <div class="field">
            <label for="f-tamano">Apartamentos o personas <span class="opt">(opcional)</span></label>
            <input id="f-tamano" name="tamano" type="text" inputmode="numeric" placeholder="Por ejemplo, 240 apartamentos" />
          </div>
        </div>
        <div class="row two">
          <div class="field">
            <label for="f-telefono">Teléfono o WhatsApp</label>
            <input id="f-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required data-msg="Escriba un teléfono para contactarlo." />
          </div>
          <div class="field">
            <label for="f-correo">Correo</label>
            <input id="f-correo" name="correo" type="email" autocomplete="email" required data-msg="Escriba un correo válido, por ejemplo nombre@conjunto.com." />
          </div>
        </div>
        <div class="field">
          <label for="f-mensaje">Mensaje <span class="opt">(opcional)</span></label>
          <textarea id="f-mensaje" name="mensaje" rows="3" placeholder="Dónde iría la máquina, horarios de acceso, dudas…"></textarea>
        </div>
        <div class="field check">
          <input id="f-autorizacion" name="autorizacion" type="checkbox" value="sí" required data-msg="Necesitamos su autorización para usar estos datos y responderle." />
          <label for="f-autorizacion">Autorizo el tratamiento de mis datos para responder esta solicitud, según el <a href="/privacidad/">aviso de privacidad</a>.</label>
        </div>

        <div class="actions">
          <button class="btn btn-primary" type="submit" disabled={!ready}>Enviar solicitud</button>
          {!ready && <p class="pending" role="status">Formulario en configuración: todavía no recibe solicitudes. Mientras tanto, escríbanos por WhatsApp o por correo.</p>}
        </div>
        <div class="error" data-form-error hidden role="alert">
          No pudimos enviar su solicitud. Revise su conexión e inténtelo de nuevo, o escríbanos directamente.
          {wa && <a href={wa} target="_blank" rel="noopener">Abrir WhatsApp</a>}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </form>

      <div class="sent" data-form-sent hidden tabindex="-1">
        <h3 class="display h-md">Recibimos su solicitud.</h3>
        <p>Lo contactaremos pronto para coordinar la visita.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    // JS takes over validation so messages can name the problem; without JS the browser validates.
    form.noValidate = true;
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const sent = document.querySelector<HTMLElement>('[data-form-sent]')!;

    const showError = (field: HTMLInputElement | HTMLSelectElement) => {
      const id = `${field.id}-error`;
      let msg = document.getElementById(id);
      if (field.validity.valid) {
        msg?.remove();
        field.removeAttribute('aria-invalid');
        return true;
      }
      if (!msg) {
        msg = document.createElement('p');
        msg.id = id;
        msg.className = 'field-error';
        field.closest('.field')!.append(msg);
      }
      msg.textContent = field.dataset.msg ?? 'Revise este campo.';
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-describedby', id);
      return false;
    };

    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    fields.forEach((f) => f.addEventListener('change', () => showError(f)));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      const invalid = fields.filter((f) => !showError(f));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      button.textContent = 'Enviando…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.success === false) throw new Error(result.message || `HTTP ${response.status}`);
        form.hidden = true;
        sent.hidden = false;
        sent.focus();
      } catch {
        errorBox.hidden = false;
        button.disabled = false;
        button.textContent = 'Enviar solicitud';
      }
    });
  }
</script>

<style>
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .grid > * { min-width: 0; }
  .info { display: grid; gap: 22px; }
  .coverage { font-weight: 800; }
  .alt { display: grid; gap: 12px; justify-items: start; margin-top: 8px; }
  .mail { font-weight: 700; }

  .form, .sent { background: var(--paper); border-radius: var(--r-card); padding: clamp(22px, 3.5vw, 40px); box-shadow: var(--shadow); }
  .form { display: grid; gap: 18px; }
  .row.two { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { display: grid; gap: 6px; align-content: start; }
  .field label { font-weight: 700; font-size: 15px; }
  .opt { font-weight: 500; color: var(--slate); }
  .field input, .field select, .field textarea {
    font: inherit; font-size: 16px; color: var(--ink); background: var(--paper);
    border: 1.5px solid #bdbdb6; border-radius: 12px; padding: 12px 14px; min-height: 50px; width: 100%;
  }
  .field ::placeholder { color: #75756e; }
  .field textarea { resize: vertical; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible {
    outline: 3px solid var(--lime-deep); outline-offset: 1px; border-color: var(--ink);
  }
  .field [aria-invalid='true'] { border-color: var(--error); background: var(--error-bg); }
  .field :global(.field-error) { color: var(--error); font-size: 14px; font-weight: 700; }
  .check { grid-template-columns: auto 1fr; align-items: start; gap: 12px; }
  .check input { width: 24px; height: 24px; min-height: 0; padding: 0; margin-top: 2px; accent-color: var(--ink); }
  .check label { font-weight: 500; }
  .check :global(.field-error) { grid-column: 1 / -1; }
  .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .pending { font-size: 14px; font-weight: 700; color: var(--slate); max-width: 42ch; }
  .error { border: 1.5px solid var(--error); border-radius: 12px; background: var(--error-bg); color: var(--error); padding: 14px 16px; font-weight: 700; display: grid; gap: 6px; }
  .error a { color: inherit; }
  .hp { position: absolute; left: -9999px; }
  .sent { display: grid; gap: 10px; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row.two { grid-template-columns: 1fr; } }
</style>
