---
import content from '../data/content.json';
---
<section id="como-funciona" class="section bg-paper" aria-labelledby="steps-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="steps-title" class="display h-lg">Usted presta el espacio. <span class="hl">Nosotros</span> hacemos el resto.</h2>
    </div>
    <ol class="steps">
      {content.steps.map((s, i) => (
        <li>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <h3 class="display h-md">{s.title}</h3>
          <p class="muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 56px); }
  .steps li { display: grid; gap: 14px; align-content: start; padding-top: 22px; border-top: 2px solid var(--ink); }
  .n {
    width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: var(--lime); font-weight: 800; font-size: 17px;
  }
  .steps p { max-width: 38ch; }
  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } }
</style>
