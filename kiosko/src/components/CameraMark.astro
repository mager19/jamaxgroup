---
// Instant-camera illustration from the FotoSnap vinyl proposal, redrawn as SVG.
interface Props { size?: number; class?: string; }
const { size = 40, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size * 1.36} viewBox="0 0 100 136" aria-hidden="true">
  <rect x="4" y="4" width="92" height="56" rx="12" fill="#ff6b6b" stroke="#153b7a" stroke-width="5" />
  <rect x="14" y="13" width="18" height="8" rx="4" fill="#ffc857" />
  <circle cx="54" cy="33" r="17" fill="#ffc857" />
  <circle cx="54" cy="33" r="12" fill="#fff" />
  <circle cx="54" cy="33" r="9.5" fill="#153b7a" />
  <circle cx="57.5" cy="29.5" r="2.6" fill="#7fb3d5" />
  <rect x="9" y="60" width="82" height="12" fill="#e8e1d8" stroke="#153b7a" stroke-width="1.5" />
  <rect x="4" y="72" width="92" height="60" rx="12" fill="#ff6b6b" stroke="#153b7a" stroke-width="5" />
  <path d="M24 74 L76 74 L82 128 L18 128 Z" fill="#ffc857" />
  <path d="M28 78 L72 78 L76 124 L24 124 Z" fill="#fff" />
  <rect x="30" y="80" width="40" height="34" fill="#f5c9a4" />
