---
import content from '../data/content.json';
import site from '../data/site.json';
import { formKey, formReady, isPlaceholder, waLink } from '../lib/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const ready = formReady();
if (!ready) {
  console.warn('[fotosnap] Web3Forms key is still a placeholder: the request form is disabled until src/data/site.json has a real key.');
}
const wa = waLink();
const email = isPlaceholder(site.email) ? null : site.email;
const redirect = new URL('/gracias/', Astro.site).href;
const eventTypes = ['Boda', 'Corporativo', 'Feria', 'Otro'];
---
<section class="section contact" id="contacto" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div class="contact-info">
      <h2 id="contact-title">Solicita <span class="em">tu kiosco</span></h2>
      <p class="lead">Cuéntanos de tu evento o de tu espacio y te contactamos para revisar la fecha y armar la propuesta.</p>
      <p class="coverage">{site.coverage}</p>
      <div class="alt">
        <p>¿Prefieres escribirnos directo?</p>
        {wa
          ? <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener"><WhatsAppIcon /> Escríbenos por WhatsApp</a>
          : <p class="placeholder">WhatsApp: {site.whatsapp}</p>}
        <p class="mail">{email ? <a href={`mailto:${email}`}>{email}</a> : <span class="placeholder">{site.email}</span>}</p>
      </div>
    </div>

    <div class="form-col">
    <form class="card form" method="POST" action="https://api.web3forms.com/submit" data-contact-form>
      <input type="hidden" name="access_key" value={formKey()} />
      <input type="hidden" name="redirect" value={redirect} />
      <input type="hidden" name="subject" value={`Nueva solicitud de kiosco ${site.brand}`} />
      <input type="hidden" name="from_name" value={`${site.brand} — landing`} />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="row two">
        <div class="field">
          <label for="f-nombre">Nombre</label>
          <input id="f-nombre" name="nombre" type="text" autocomplete="name" required data-msg="Escribe tu nombre." />
        </div>
        <div class="field">
          <label for="f-empresa">Empresa u organización <span class="opt">(opcional)</span></label>
          <input id="f-empresa" name="empresa" type="text" autocomplete="organization" />
        </div>
      </div>
      <div class="row two">
        <div class="field">
          <label for="f-correo">Correo</label>
          <input id="f-correo" name="correo" type="email" autocomplete="email" required data-msg="Escribe un correo válido, por ejemplo nombre@empresa.com." />
        </div>
        <div class="field">
          <label for="f-telefono">Teléfono o WhatsApp</label>
          <input id="f-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required data-msg="Escribe un teléfono para contactarte." />
        </div>
      </div>
      <div class="row two">
        <div class="field">
          <label for="f-tipo">¿Qué te interesa?</label>
          <select id="f-tipo" name="tipo" required data-msg="Elige la modalidad que te interesa.">
            <option value="">Elige una opción</option>
            {content.modalities.map((m) => <option value={m.id}>{m.title}</option>)}
          </select>
        </div>
        <div class="field" data-event-only>
          <label for="f-tipo-evento">Tipo de evento <span class="opt">(opcional)</span></label>
          <select id="f-tipo-evento" name="tipo_evento">
            <option value="">Elige una opción</option>
            {eventTypes.map((t) => <option>{t}</option>)}
          </select>
        </div>
      </div>
      <div class="row two">
        <div class="field">
          <label for="f-fecha" data-date-label>Fecha del evento o de inicio</label>
          <input id="f-fecha" name="fecha" type="date" required data-msg="Elige la fecha." />
        </div>
        <div class="field">
          <label for="f-ciudad">Ciudad</label>
          <input id="f-ciudad" name="ciudad" type="text" autocomplete="address-level2" required data-msg="Escribe la ciudad." />
        </div>
      </div>
      <div class="field">
        <label for="f-mensaje">Mensaje <span class="opt">(opcional)</span></label>
        <textarea id="f-mensaje" name="mensaje" rows="4"></textarea>
      </div>
      <div class="field check">
        <input id="f-autorizacion" name="autorizacion" type="checkbox" value="sí" required data-msg="Necesitamos tu autorización para usar estos datos y responderte." />
        <label for="f-autorizacion">Autorizo el tratamiento de mis datos para responder esta solicitud, según el <a href="/privacidad/">aviso de privacidad</a>.</label>
      </div>

      <div class="actions">
        <button class="btn btn-primary" type="submit" disabled={!ready}>Enviar solicitud</button>
        {!ready && <p class="pending" role="status">Formulario en configuración: todavía no recibe solicitudes. Mientras tanto, escríbenos por los canales de contacto.</p>}
      </div>
      <div class="error" data-form-error hidden role="alert">
        No pudimos enviar tu solicitud. Revisa tu conexión e inténtalo de nuevo{wa || email ? ', o escríbenos directamente' : ''}.
        {wa && <a href={wa} target="_blank" rel="noopener">Abrir WhatsApp</a>}
        {email && <a href={`mailto:${email}`}>{email}</a>}
      </div>
    </form>

    <div class="card sent" data-form-sent hidden tabindex="-1">
      <h3>Recibimos tu solicitud. Te contactaremos pronto.</h3>
      <p>Gracias por escribirnos.</p>
    </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    // JS takes over validation so messages can name the problem; without JS the browser validates.
    form.noValidate = true;
    const tipo = form.querySelector<HTMLSelectElement>('[name="tipo"]')!;
    const eventOnly = form.querySelector<HTMLElement>('[data-event-only]')!;
    const dateLabel = form.querySelector<HTMLElement>('[data-date-label]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const sent = document.querySelector<HTMLElement>('[data-form-sent]')!;

    // Event subtype and date wording follow the chosen modality.
    const syncType = () => {
      const isMall = tipo.value === 'centro-comercial';
      eventOnly.hidden = isMall;
      dateLabel.textContent = isMall ? 'Fecha de inicio' : tipo.value ? 'Fecha del evento' : 'Fecha del evento o de inicio';
    };
    tipo.addEventListener('change', syncType);
    syncType();

    const showError = (field: HTMLInputElement | HTMLSelectElement) => {
      const id = `${field.id}-error`;
      let msg = document.getElementById(id);
      if (field.validity.valid) {
        msg?.remove();
        field.removeAttribute('aria-invalid');
        return true;
      }
      if (!msg) {
        msg = document.createElement('p');
        msg.id = id;
        msg.className = 'field-error';
        field.closest('.field')!.append(msg);
      }
      msg.textContent = field.dataset.msg ?? 'Revisa este campo.';
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-describedby', id);
      return false;
    };

    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    fields.forEach((f) => f.addEventListener('change', () => showError(f)));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      const invalid = fields.filter((f) => !showError(f));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      button.textContent = 'Enviando…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.success === false) throw new Error(result.message || `HTTP ${response.status}`);
        form.hidden = true;
        sent.hidden = false;
        sent.focus();
      } catch {
        errorBox.hidden = false;
        button.disabled = false;
        button.textContent = 'Enviar solicitud';
      }
    });
  }
</script>

<style>
  .contact { background: var(--cream); }
  .contact-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .contact-info .lead { font-size: 19px; color: var(--slate); margin: 16px 0 20px; max-width: 40ch; }
  .coverage { display: inline-block; font-weight: 800; color: var(--navy); background: var(--sun); border: 0; border-radius: 14px; padding: 8px 16px; }
  .alt { margin-top: 32px; display: grid; gap: 12px; justify-items: start; }
  .alt .mail a { font-weight: 700; text-underline-offset: 3px; }
  .placeholder { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; background: var(--note-bg); padding: 2px 6px; }

  .form { padding: clamp(22px, 3.5vw, 36px); display: grid; gap: 18px; }
  .row.two { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { display: grid; gap: 6px; align-content: start; }
  .field label { font-weight: 700; font-size: 15px; color: var(--navy); }
  .opt { font-weight: 500; color: var(--slate); }
  .field input, .field select, .field textarea {
    font: inherit; font-size: 16px; color: var(--navy); background: var(--paper);
    border: 1.5px solid var(--field-line); border-radius: 14px; padding: 12px 14px; min-height: 50px; width: 100%;
  }
  .field textarea { resize: vertical; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--yellow); outline-offset: 1px; border-color: var(--navy); }
  .field [aria-invalid='true'] { border-color: var(--error); background: var(--error-bg); }
  .field :global(.field-error) { color: var(--error); font-size: 14px; font-weight: 700; }
  .check { grid-template-columns: auto 1fr; align-items: start; gap: 12px; }
  .check input { width: 24px; height: 24px; min-height: 0; padding: 0; margin-top: 2px; accent-color: var(--navy); }
  .check label { font-weight: 500; }
  .check :global(.field-error) { grid-column: 1 / -1; }
  .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .pending { font-size: 14px; font-weight: 700; color: var(--slate); max-width: 42ch; }
  .error { border: 1.5px solid var(--error-line); border-radius: 14px; background: var(--error-bg); color: var(--error-ink); padding: 14px 16px; font-weight: 700; display: grid; gap: 6px; }
  .error a { color: inherit; }
  .hp { position: absolute; left: -9999px; }
  .sent { padding: 36px; background: var(--sun); }
  .sent h3 { font-size: clamp(24px, 3vw, 32px); }
  .sent p { margin-top: 8px; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row.two { grid-template-columns: 1fr; } }
</style>
