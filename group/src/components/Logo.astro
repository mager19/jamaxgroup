---
import site from '../data/site.json';
// Isotype: a "J" with three dots, one per business in its own brand color (travel, FotoSnap, vending).
---
<a class="logo" href="/" aria-label={`${site.brand}, inicio`}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect class="tile" width="32" height="32" rx="8" />
    <path class="j" d="M20.5 8v11.5a5.5 5.5 0 0 1-11 0" fill="none" stroke-width="4" stroke-linecap="round" />
    <circle cx="8" cy="8.5" r="2.2" fill="#3d8bff" />
    <circle cx="14" cy="8.5" r="2.2" fill="#ff6b6b" />
    <circle cx="8" cy="14.5" r="2.2" fill="#b5dd34" />
  </svg>
  <span>jamax <b>group</b></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo svg { width: 32px; height: 32px; flex: none; }
  .tile { fill: var(--ink); }
  .j { stroke: var(--orange); }
  .logo span { font-size: 20px; font-weight: 500; letter-spacing: -0.04em; }
  .logo b { font-weight: 700; }
  :global(.on-ink) .tile { fill: var(--on-ink); }
</style>
