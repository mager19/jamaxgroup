---
import site from '../data/site.json';
import { waLink } from '../lib/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const wa = waLink();
---
<section id="contacto" class="section on-ink" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="section-head">
      <p class="label">03 / Contacto</p>
      <h2 id="contact-title" class="h-lg">Hablemos. <span class="accent">Te respondemos nosotros.</span></h2>
      <p class="lead">Cuéntanos qué necesitas y te ponemos en contacto con el negocio indicado.</p>
    </div>
    <ul class="channels">
      {wa && (
        <li>
          <a href={wa} target="_blank" rel="noopener">
            <span class="kind"><WhatsAppIcon /> WhatsApp</span>
            <span class="value">{site.whatsappLabel}</span>
            <span class="arrow" aria-hidden="true">↗</span><span class="sr">(se abre en una pestaña nueva)</span>
          </a>
        </li>
      )}
      <li>
        <a href={`mailto:${site.email}`}>
          <span class="kind">Correo</span>
          <span class="value">{site.email}</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: end; }
  .grid > * { min-width: 0; }
  .section-head { margin-bottom: 0; }
  .channels { border-top: 1px solid rgb(244 242 238 / 0.2); }
  .channels a {
    display: grid; grid-template-columns: 120px 1fr auto; align-items: center; gap: 16px;
    padding: 26px 0; border-bottom: 1px solid rgb(244 242 238 / 0.2); text-decoration: none;
    transition: padding 0.35s var(--ease-out), color 0.2s;
  }
  .channels a:hover { padding-left: 12px; color: var(--orange); }
  .kind { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--on-ink-dim); }
  .value { font-size: clamp(20px, 2.4vw, 30px); letter-spacing: -0.03em; overflow-wrap: anywhere; }
  .arrow { font-size: 22px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .channels a { grid-template-columns: 1fr auto; } .kind { grid-column: 1 / -1; } }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
