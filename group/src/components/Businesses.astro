---
import { Image } from 'astro:assets';
import content from '../data/content.json';
import { asset } from '../lib/media';
---
<section id="negocios" class="section bg-bone-2" aria-labelledby="biz-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">01 / Lo que hacemos</p>
      <h2 id="biz-title" class="h-lg">Tres negocios. <span class="accent">Un mismo equipo.</span></h2>
    </div>
    <div class="cards">
      {content.businesses.map((b) => (
        <article style={`--brand:${b.color}`}>
          <div class="photo">
            <Image src={asset(b.cardImage.file)} alt={b.cardImage.alt} widths={[400, 640, 900]} sizes="(max-width: 960px) 92vw, 380px" />
          </div>
          <div class="top">
            <p class="kind">{b.title}</p>
            <svg class="mark" viewBox="0 0 60 14" aria-hidden="true"><path d="M2 10 L20 4 L34 10 L58 3" fill="none" stroke="var(--brand)" stroke-width="5" stroke-linejoin="round" stroke-linecap="round" /></svg>
          </div>
          <h3>{b.name}</h3>
          <p class="line">{b.line}</p>
          <p class="for">{b.for}</p>
          <ul class="tags">{b.tags.map((t) => <li>{t}</li>)}</ul>
          <a class="link-arrow go" href={b.url} target="_blank" rel="noopener">
            {b.domain} <span aria-hidden="true">↗</span><span class="sr">(se abre en una pestaña nueva)</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  article {
    display: grid; grid-template-rows: auto auto auto 1fr auto auto auto; gap: 14px;
    padding: 10px 10px clamp(24px, 2.6vw, 32px); background: var(--card); border: 1px solid var(--line); border-radius: var(--r);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  article:hover { transform: translateY(-4px); box-shadow: 0 24px 40px -28px rgb(26 26 24 / 0.35); }
  .photo { border-radius: 9px; overflow: hidden; aspect-ratio: 16 / 10; margin-bottom: 8px; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  article:hover .photo :global(img) { transform: scale(1.04); }
  .top, h3, .line, .for, .tags, .go { margin-inline: clamp(14px, 1.6vw, 22px); }
  .top { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
  .mark { width: 60px; height: 14px; }
  .kind { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); }
  h3 { font-size: clamp(26px, 2.4vw, 32px); }
  .line { color: var(--slate); }
  .for { font-weight: 600; font-size: 15px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px 14px; font-family: var(--mono); font-size: 12px; color: var(--slate); }
  .go { justify-self: start; margin-top: 10px; font-size: 15px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 960px) { .cards { grid-template-columns: 1fr; } article { grid-template-rows: none; } }
</style>
