---
import { Image } from 'astro:assets';
import content from '../data/content.json';
import { asset } from '../lib/media';

// One photo per business, each a doorway to its site. Staggered like a contact sheet.
---
<div class="collage">
  {content.businesses.map((b, i) => (
    <a class={`tile t${i + 1}`} href={b.url} target="_blank" rel="noopener" style={`--brand:${b.color}`}>
      <Image src={asset(b.heroImage.file)} alt={b.heroImage.alt} widths={[360, 560, 820]} sizes="(max-width: 900px) 46vw, 300px" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
      <span class="tag"><i aria-hidden="true"></i>0{i + 1} · {b.short}<span class="sr"> — {b.name}, se abre en una pestaña nueva</span></span>
    </a>
  ))}
</div>

<style>
  .collage {
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: 14px; aspect-ratio: 5 / 6; width: min(560px, 100%); justify-self: end;
  }
  .tile {
    position: relative; overflow: hidden; border-radius: var(--r); display: block; text-decoration: none;
    box-shadow: 0 30px 50px -36px rgb(26 26 24 / 0.55);
  }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  .tile:hover :global(img) { transform: scale(1.04); }
  .t1 { grid-column: 1; grid-row: 1 / 5; }
  .t2 { grid-column: 2; grid-row: 2 / 7; }
  .t2 :global(img) { object-position: 60% 40%; }
  .t3 { grid-column: 1; grid-row: 5 / 7; }
  .tag {
    position: absolute; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 11px; border-radius: 999px; background: rgb(249 248 245 / 0.94); color: var(--ink);
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .tag i { width: 8px; height: 8px; border-radius: 50%; background: var(--brand); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .collage { animation: rise 1.1s var(--ease-out) both; }
  @keyframes rise { from { transform: translateY(14px); } to { transform: none; } }
  @media (max-width: 900px) { .collage { justify-self: stretch; width: 100%; aspect-ratio: 4 / 5; } }
</style>
