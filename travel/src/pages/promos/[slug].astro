---
import Base from '../../layouts/Base.astro';
import PromoCard from '../../components/PromoCard.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import site from '../../data/site.json';
import { fmtCOP, getPromos, img, waLink, type Promo } from '../../lib/promos';

export async function getStaticPaths() {
  const promos = await getPromos();
  return promos.map((promo) => ({
    params: { slug: promo.id },
    props: { promo, related: promos.filter((x) => x.id !== promo.id).slice(0, 3) },
  }));
}

interface Props {
  promo: Promo;
  related: Promo[];
}

const { promo, related } = Astro.props;
const p = promo.data;
// Gallery order: two left tiles, large center, two right tiles.
const gallery = [p.images[1], p.images[3], p.images[0], p.images[2], p.images[4]];
---
<Base title={`${p.title} — ${site.brand}`} description={p.summary}>
  <main class="wrap">
    <div class="gallery">
      {gallery.map((url, i) => <img src={img(url, 1000)} alt={p.destination} loading={i === 2 ? 'eager' : 'lazy'} />)}
    </div>
    <div class="detail">
      <article>
        <div class="tags">
          <span class="tag">{p.category}</span>
          <span class:list={['tag', { 'tag-alert': p.urgent }]}>{p.badge}</span>
          <span class="caption">{p.origin}</span>
        </div>
        <h1>{p.title}</h1>
        <p class="intro">{p.summary}</p>
        <div class="facts">
          <div class="fact"><span class="caption">Duración</span><strong>{p.nights} noches</strong></div>
          <div class="fact"><span class="caption">Destino</span><strong>{p.destination}</strong></div>
          <div class="fact"><span class="caption">Alojamiento</span><strong>{p.hotel}</strong></div>
          <div class="fact"><span class="caption">Temporada</span><strong>{p.season}</strong></div>
        </div>
        <h2>Qué incluye</h2>
        <ul class="list-box">{p.includes.map((item) => <li>{item}</li>)}</ul>
        {p.excludes.length > 0 && (
          <>
            <h2>No incluye</h2>
            <ul class="list-box no">{p.excludes.map((item) => <li>{item}</li>)}</ul>
          </>
        )}
      </article>
      <aside class="side">
        <span class="flag">{p.badge}</span>
        <div class="caption">Desde</div>
        <div class="big">{fmtCOP(p.priceFrom)} <small>COP</small></div>
        <div class="caption">{p.priceNote}</div>
        <div class="rows">
          <div class="row"><span>Salida sugerida</span><strong>{p.departure}</strong></div>
          <div class="row"><span>Temporada</span><strong>{p.season}</strong></div>
          <div class="row"><span>Duración</span><strong>{p.nights} noches</strong></div>
        </div>
        <a class="btn btn-blue btn-block" href={waLink(promo)} target="_blank" rel="noopener"><WhatsAppIcon /> Cotizar gratis por WhatsApp</a>
        <p class="free">Asesoría personalizada y sin costo</p>
        <p class="disclaimer">Tarifa de referencia sujeta a disponibilidad. Operado por {site.operator} · {site.rnt}.</p>
      </aside>
    </div>
  </main>
  {related.length > 0 && (
    <section class="section light" style="background:var(--linen)">
      <div class="wrap">
        <div class="section-head"><h2>También te puede gustar</h2></div>
        <div class="grid">{related.map((r) => <PromoCard promo={r} />)}</div>
      </div>
    </section>
  )}
</Base>
