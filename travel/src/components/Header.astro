---
import site from '../data/site.json';
import { getPromos, promoUrl, waLink } from '../lib/promos';
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const { announcement } = site;
// The bar only shows while its promo is live, so it never announces an expired trip.
const livePromos = await getPromos();
const announcedPromo = livePromos.find((p) => p.id === announcement.promo);
const showAnnouncement = Boolean(announcement.text) && (!announcement.promo || announcedPromo);
---
{showAnnouncement && (
  <div class="announce">
    {announcement.text}
    {announcedPromo && <a href={promoUrl(announcedPromo)}>{announcement.linkText}</a>}
  </div>
)}
<div class="nav-shell">
  <header class="nav">
    <Logo />
    <nav class="nav-links" aria-label="Principal">
      <a href="/#promos">Promos</a>
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/#destinos">Destinos</a>
    </nav>
    <a class="btn btn-ghost btn-ghost-sm" href={waLink()} target="_blank" rel="noopener"><WhatsAppIcon /> Asesor</a>
  </header>
</div>
