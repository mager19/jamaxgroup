---
import site from '../data/site.json';
import { promoUrl, waLink } from '../lib/promos';
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const { announcement } = site;
---
{announcement.text && (
  <div class="announce">
    {announcement.text}
    {announcement.promo && <a href={promoUrl(announcement.promo)}>{announcement.linkText}</a>}
  </div>
)}
<div class="nav-shell">
  <header class="nav">
    <Logo />
    <nav class="nav-links" aria-label="Principal">
      <a href="/#promos">Promos</a>
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/#destinos">Destinos</a>
    </nav>
    <a class="btn btn-ghost btn-ghost-sm" href={waLink()} target="_blank" rel="noopener"><WhatsAppIcon /> Asesor</a>
  </header>
</div>
